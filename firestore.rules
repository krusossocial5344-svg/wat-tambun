rules_version = '2';

// กฎความปลอดภัยของระบบทำบุญวัด
// - ทุกคนอ่านข้อมูลงานบุญ บัญชี และรายนามได้ (เพื่อให้ลิงก์แชร์เปิดดูได้โดยไม่ต้องเข้าสู่ระบบ)
// - เจ้าหน้าที่ (staff) เพิ่มรายชื่อผู้ทำบุญได้อย่างเดียว แก้หรือลบไม่ได้
// - แอดมิน (admin) ทำได้ทุกอย่าง
// แก้อีเมลด้านล่างให้เป็นอีเมลแอดมินหลัก ให้ตรงกับไฟล์ firebase-config.js

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function email() { return request.auth.token.email.lower(); }
    function isOwner() {
      return signedIn() && request.auth.token.email_verified == true
        && email() in ['krusossocial5344@gmail.com'];
    }
    function roleIs(r) {
      return signedIn()
        && exists(/databases/$(database)/documents/roles/$(email()))
        && get(/databases/$(database)/documents/roles/$(email())).data.role == r;
    }
    function isAdmin() { return isOwner() || roleIs('admin'); }
    function isStaff() { return isAdmin() || roleIs('staff'); }

    function validDonation(d) {
      return d.keys().hasOnly(['campaignId','name','nameImg','amount','date','note','wantReceipt','receiptSent','source','method','createdAt','createdBy','createdByName','editedAt','editedBy'])
        && d.keys().hasAll(['campaignId','name','amount','date','note','wantReceipt','receiptSent','createdAt','createdBy'])
        && d.campaignId is string
        && existsAfter(/databases/$(database)/documents/campaigns/$(d.campaignId))
        && d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.amount is int && d.amount > 0 && d.amount <= 100000000
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.note is string && d.note.size() <= 500
        && d.wantReceipt is bool && d.receiptSent is bool
        && (!('nameImg' in d) || (d.nameImg is string && d.nameImg.size() < 200000 && d.nameImg.matches('^data:image/png;base64,.*')))
        && (!('source' in d) || d.source in ['staff','slip','import'])
        && (!('method' in d) || d.method in ['cash','transfer','qr'])
        && (!('createdByName' in d) || (d.createdByName is string && d.createdByName.size() <= 120))
        && d.createdBy is string;
    }
    function validSlip(d) {
      return d.keys().hasOnly(['campaignId','name','anon','realName','amount','date','note','wantReceipt','receipt','img','imgHash','status','createdAt','uid'])
        // ต้องส่งพร้อมโควตาของเครื่องนี้ใน batch เดียวกัน (กันบอทยิงสลิปรัว ๆ)
        && request.auth != null && d.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/slipQuota/$(request.auth.uid)).data.lastAt == request.time
        && (!('anon' in d) || d.anon is bool)
        && (!('realName' in d) || (d.realName is string && d.realName.size() <= 200))
        && d.campaignId is string && exists(/databases/$(database)/documents/campaigns/$(d.campaignId))
        && d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.amount is int && d.amount > 0 && d.amount <= 100000000
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.note is string && d.note.size() <= 300
        && d.wantReceipt is bool
        && (d.receipt == null || (d.receipt is map && d.receipt.keys().hasOnly(['receiptName','taxId','address','phone','note'])))
        && d.img is string && d.img.size() < 900000 && d.img.matches('^data:image/jpeg;base64,.*')
        && d.status == 'pending' && d.createdAt == request.time;
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /accounts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /campaigns/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /roles/{mail} {
      allow read: if isAdmin() || (signedIn() && email() == mail);
      allow write: if isAdmin();
    }
    // โควตาส่งสลิปต่อเครื่อง (บัญชีนิรนามของ Firebase): ห่างกันอย่างน้อย 1 นาที และไม่เกิน 10 ใบใน 24 ชั่วโมง
    function quotaKeys(d) { return d.keys().hasOnly(['lastAt','windowStart','n']) && d.lastAt == request.time && d.n is int; }
    match /slipQuota/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid && quotaKeys(request.resource.data)
        && request.resource.data.windowStart == request.time && request.resource.data.n == 1;
      allow update: if request.auth != null && request.auth.uid == uid && quotaKeys(request.resource.data)
        && request.time > resource.data.lastAt + duration.value(60, 's')
        && ((request.time < resource.data.windowStart + duration.value(1, 'd')
              && request.resource.data.windowStart == resource.data.windowStart
              && request.resource.data.n == resource.data.n + 1 && request.resource.data.n <= 10)
          || (request.time >= resource.data.windowStart + duration.value(1, 'd')
              && request.resource.data.windowStart == request.time && request.resource.data.n == 1));
      allow delete: if false;
    }
    // สลิปจากผู้ทำบุญ: ใครก็ส่งได้ (ระบบเข้าสู่ระบบแบบนิรนามให้อัตโนมัติ ผู้ทำบุญไม่ต้องทำอะไร) แต่อ่าน/ตรวจได้เฉพาะเจ้าหน้าที่
    match /slips/{id} {
      allow create: if validSlip(request.resource.data) || isAdmin();
      allow read, update: if isStaff();
      allow delete: if isAdmin();
    }
    // คำขอใบอนุโมทนา (มีเลขผู้เสียภาษีและที่อยู่): เจ้าหน้าที่ส่งได้ แอดมินเท่านั้นที่อ่านได้
    match /receipts/{id} {
      allow create: if isAdmin() || isStaff() && request.resource.data.status == 'pending'
        && request.resource.data.taxId is string && request.resource.data.taxId.size() <= 20
        && request.resource.data.address is string && request.resource.data.address.size() <= 500;
      allow read, update, delete: if isAdmin();
    }
    // ประวัติการทำรายการ: เพิ่มได้อย่างเดียว ห้ามแก้หรือลบ (แม้แต่แอดมิน)
    match /logs/{id} {
      allow create: if isStaff() && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time
        && request.resource.data.summary is string && request.resource.data.summary.size() <= 500;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    // ปิดยอดประจำวัน: เจ้าหน้าที่ปิดยอดของตัวเอง แอดมินปิดแทนได้
    match /closings/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff() && (isAdmin() || request.resource.data.uid == request.auth.uid)
        && request.resource.data.by == request.auth.uid && request.resource.data.counted is number;
      allow delete: if false;
    }
    // ใครกำลังใช้งานอยู่
    match /presence/{uid} {
      allow read: if isStaff();
      allow write: if isStaff() && request.auth.uid == uid;
    }
    match /donations/{id} {
      allow read: if true;
      // เจ้าหน้าที่เพิ่มรายการใหม่ได้ (ในชื่อตัวเอง เวลาเป็นเวลาของเซิร์ฟเวอร์ และยังไม่ได้ออกใบ)
      allow create: if isStaff()
        && validDonation(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (isAdmin() || request.resource.data.receiptSent == false);
      // แก้ไข (เช่น ติ๊กว่าออกใบอนุโมทนาแล้ว) และลบ: แอดมินเท่านั้น
      allow update: if isAdmin() && validDonation(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
